# --- SHA-256 ANTI-CORRUPTION LEDGER CLASS ---
class AntiCorruptionLedger:
    def __init__(self):
        if "ledger" not in st.session_state:
            st.session_state.ledger = []

    def compute_hash(self, block):
        block_string = json.dumps(block, sort_keys=True).encode()
        return hashlib.sha256(block_string).hexdigest()

    def add_record(self, temp, gas, pressure, risk_score, alert_status):
        prev_hash = st.session_state.ledger[-1]["current_hash"] if st.session_state.ledger else "GENESIS_BLOCK_0000"
        timestamp = time.strftime("%Y-%m-%d %H:%M:%S")
        
        block = {
            "index": len(st.session_state.ledger) + 1,
            "timestamp": timestamp,
            "temperature_c": temp,
            "mq2_gas_ppm": gas,
            "pressure_bar": pressure,
            "risk_score": risk_score,
            "alert_status": alert_status,
            "previous_hash": prev_hash
        }
        
        current_hash = self.compute_hash(block)
        block["current_hash"] = current_hash
        st.session_state.ledger.append(block)

    def verify_integrity(self):
        for i in range(len(st.session_state.ledger)):
            current = st.session_state.ledger[i]
            prev_hash = st.session_state.ledger[i-1]["current_hash"] if i > 0 else "GENESIS_BLOCK_0000"
            
            if current["previous_hash"] != prev_hash:
                return False, i
            
            # Recompute block hash without current_hash key
            check_block = {k: v for k, v in current.items() if k != "current_hash"}
            if self.compute_hash(check_block) != current["current_hash"]:
                return False, i
        return True, -1

ledger_system = AntiCorruptionLedger()

# --- NLP ADVISORY GENERATOR ---
def generate_nlp_instructions(risk_score, temp, gas):
    if risk_score < 40:
        return {
            "floor": "Nominal operations. Maintain routine visual inspections on Valve Array 4.",
            "district": "System green. No administrative action required.",
            "ndrf": "Standby mode. Regional disaster response units on routine status.",
            "ngos": "No public safety advisories active."
        }
    elif risk_score < 75:
        return {
            "floor": f"WARNING: Elevated gas ({gas} PPM) detected. Engage nitrogen purge protocol on Line B immediately.",
            "district": "AUTOMATED ALERT: Minor operational anomaly logged. Review automated sensor feed.",
            "ndrf": "ADVISORY: Monitor regional plant coordinates. Prep Level-1 Hazmat response team.",
            "ngos": "Community alert: No public evacuation needed. Air quality sensors active."
        }
    else:
        return {
            "floor": f"CRITICAL HAZARD: Thermal runaway ({temp}°C) imminent! Initiate automated emergency reactor shutdown and evacuate sector 3.",
            "district": "NON-BYPASSABLE EMERGENCY: Automatic override engaged. Establish 2.5 km perimeter downwind of plant.",
            "ndrf": "NATIONAL EMERGENCY DISPATCHED: Deploy Hazmat & Search/Rescue teams to Sector 4 immediately.",
            "ngos": "PUBLIC SAFETY ALERT: Broadcast shelter-in-place advisory for low-lying districts downwind."
        }

